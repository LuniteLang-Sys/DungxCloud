{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Unhealthy Account Count",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "nas_unhealthy_accounts_total",
          "legendFormat": "Unhealthy Shards",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "title": "Upload Success Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(sum(rate(nas_upload_attempts_total{status=\"completed\"}[5m])) / sum(rate(nas_upload_attempts_total[5m]))) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 98 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "id": 3,
      "title": "Download Success Rate",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(sum(rate(nas_download_attempts_total{status=\"completed\"}[5m])) / sum(rate(nas_download_attempts_total[5m]))) * 100",
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 97 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "id": 4,
      "title": "Google OAuth Latency (95th %)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(nas_google_oauth_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Duration",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1.5 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "title": "Aggregated Storage Pool Capacity",
      "type": "gauge",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "nas_total_storage_bytes{state=\"used\"}",
          "legendFormat": "Used Space",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "max": 48318382080,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 41000000000 },
              { "color": "red", "value": 45000000000 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "title": "Transient Network Retries vs Recoveries",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "rate(nas_chunk_retry_attempts_total[5m])",
          "legendFormat": "Chunk Retries / sec",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "expr": "rate(nas_recovered_uploads_total[5m])",
          "legendFormat": "Upload Recoveries / sec",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    }
  ],
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["sre", "storage", "nas"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Smart Cloud Pool NAS Operations Dashboard",
  "timezone": "browser",
  "version": 1
}
